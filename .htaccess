# Vladora — intestazioni di sicurezza.
# L'hosting non ne manda nessuna: verificato in produzione il 2026-09-15,
# la risposta aveva solo cache-control, etag e content-type.
#
# Tutto sta dentro <IfModule>: se il modulo non c'e', Apache ignora il
# blocco invece di rispondere 500. Dopo il caricamento verificare che le
# intestazioni compaiano davvero — alcuni piani gratuiti bloccano headers.

<IfModule mod_headers.c>
  # Nessuno puo' incorniciare il sito: difesa dal clickjacking.
  # La CSP nel <meta> non puo' esprimere frame-ancestors, solo un header.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"

  # Il browser non indovina il tipo di un file: niente .txt eseguito come script.
  Header always set X-Content-Type-Options "nosniff"

  # Verso l'esterno esce l'origine, mai il percorso completo.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Il sito non usa nulla di tutto questo: lo dichiariamo esplicitamente.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

  # HTTPS obbligatorio per sei mesi.
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

# Materiale di lavorazione: niente da servire, nemmeno a chi indovina l'URL.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^uploads/ - [F,L]
  RewriteRule ^prompt- - [F,L]
  RewriteRule ^\.dev-server\.pl$ - [F,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/json image/svg+xml
</IfModule>
